---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Read files from the public/content/artwork folders
function getFilesFromFolder(folderName: string): string[] {
  const dir = path.join(process.cwd(), 'public', 'content', 'artwork', folderName);
  let files: string[] = [];
  if (fs.existsSync(dir)) {
    files = fs.readdirSync(dir).filter(file => /\.(png|jpe?g|svg|webp|gif|mp4)$/i.test(file));
  }
  return files.map(file => `/content/artwork/${folderName}/${file}`);
}

const eventsImages = getFilesFromFolder('events-tours');
const brandingImages = getFilesFromFolder('graphic-design-branding');
const motionImages = getFilesFromFolder('motion-graphics-animation');
const videoImages = getFilesFromFolder('video-production');
const uiuxImages = getFilesFromFolder('ui-ux-web-design');
---

<BaseLayout title="Work — Jadd Steinhard">
	<section class="work-section">
		<h1 class="display-headline">Selected Work.</h1>
		<p class="sub-body">A diverse blend of creative, technical, and soft skills to design, animate, and produce engaging content.</p>

		<!-- Events / Tours Operations -->
		<div class="work-category">
			<p class="section-label">Events & Tours Operations</p>
			<div class="work-grid">
				{eventsImages.length > 0 ? eventsImages.map((img) => (
					<div class="work-tile">
						<img src={img} alt="Event or Tour visual" loading="lazy" />
					</div>
				)) : (
					<p class="placeholder-text">[TODO: Jadd — Drop your Events/Tours artwork here]</p>
				)}
			</div>
		</div>

		<!-- Brand Campaigns & Advertising -->
		<div class="work-category">
			<p class="section-label">Brand Campaigns & Advertising</p>
			<div class="work-grid">
				{brandingImages.length > 0 ? brandingImages.map((img) => (
					<div class="work-tile">
						<img src={img} alt="Brand identity or campaign visual" loading="lazy" />
					</div>
				)) : (
					<p class="placeholder-text">[TODO: Jadd — Drop your Branding artwork here]</p>
				)}
			</div>
		</div>

		<!-- Motion Graphics & Animation -->
		<div class="work-category">
			<p class="section-label">Motion Graphics & Animation</p>
			<div class="work-grid">
				{motionImages.length > 0 ? motionImages.map((img) => (
					<div class="work-tile">
						<img src={img} alt="Motion graphic visual" loading="lazy" />
					</div>
				)) : (
					<p class="placeholder-text">[TODO: Jadd — Drop your Motion Graphics artwork here]</p>
				)}
			</div>
		</div>

		<!-- Video Production -->
		<div class="work-category">
			<p class="section-label">Video Production</p>
			<div class="work-grid">
				{videoImages.length > 0 ? videoImages.map((img) => (
					<div class="work-tile">
						<img src={img} alt="Video production visual" loading="lazy" />
					</div>
				)) : (
					<p class="placeholder-text">[TODO: Jadd — Drop your Video Production artwork here]</p>
				)}
			</div>
		</div>

		<!-- UI/UX & Web Design -->
		<div class="work-category">
			<p class="section-label">UI/UX & Web Design</p>
			<div class="work-grid">
				{uiuxImages.length > 0 ? uiuxImages.map((img) => (
					<div class="work-tile">
						<img src={img} alt="UI/UX web design visual" loading="lazy" />
					</div>
				)) : (
					<p class="placeholder-text">[TODO: Jadd — Drop your UI/UX artwork here]</p>
				)}
			</div>
		</div>
	</section>
</BaseLayout>