---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Helper to read a single project folder
function getProject(folderPath: string) {
  const files = fs.readdirSync(folderPath);
  const infoFile = files.find(f => f === 'info.txt');
  const images = files.filter(f => /\.(png|jpe?g|svg|webp|gif)$/i.test(f));

  let title = path.basename(folderPath).replace(/-/g, ' ');
  let subtitle = '';
  const sections: { heading: string; text: string }[] = [];

  if (infoFile) {
    const content = fs.readFileSync(path.join(folderPath, infoFile), 'utf-8');
    const lines = content.split('\n');
    const allowedKeys = [
      'Title', 'Subtitle', 'Vision', 'Feedback & Ethics', 'Growth & Wellbeing', 
      'Brand & Community', 'Creative Process', 'Visual Identity', 'Graphic Layer & Typography'
    ];

    lines.forEach(line => {
      const [key, ...rest] = line.split(':');
      const value = rest.join(':').trim();
      if (!value) return;

      if (key.trim().toLowerCase() === 'title') {
        title = value;
      } else if (key.trim().toLowerCase() === 'subtitle') {
        subtitle = value;
      } else if (allowedKeys.some(k => k.toLowerCase() === key.trim().toLowerCase() && k !== 'Title' && k !== 'Subtitle')) {
        sections.push({ heading: key.trim(), text: value });
      }
    });
  }

  return {
    title,
    subtitle,
    images: images.map(img => `/content/artwork/${path.basename(path.dirname(folderPath))}/${path.basename(folderPath)}/${img}`),
    sections
  };
}

function getProjects(category: string) {
  const baseDir = path.join(process.cwd(), 'public', 'content', 'artwork', category);
  if (!fs.existsSync(baseDir)) return [];

  const directories = fs.readdirSync(baseDir, { withFileTypes: true })
    .filter(dirent => dirent.isDirectory())
    .map(dirent => dirent.name);

  const singleImages = fs.readdirSync(baseDir).filter(file => /\.(png|jpe?g|svg|webp|gif)$/i.test(file))
    .map(file => ({
      title: path.parse(file).name.replace(/-/g, ' '),
      subtitle: '',
      images: [`/content/artwork/${category}/${file}`],
      sections: []
    }));

  const projects = directories.map(dir => getProject(path.join(baseDir, dir)));
  return [...singleImages, ...projects].sort((a, b) => a.title.localeCompare(b.title));
}

const eventsProjects = getProjects('events-tours');
const brandingProjects = getProjects('graphic-design-branding');
const motionProjects = getProjects('motion-graphics-animation');
const videoProjects = getProjects('video-production');
const uiuxProjects = getProjects('ui-ux-web-design');
