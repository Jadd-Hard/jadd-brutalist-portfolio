		<h1 class="display-headline">Selected Work.</h1>
		<p class="sub-body">A diverse blend of creative, technical, and soft skills to design, animate, and produce engaging content.</p>

		<!-- Brand Campaigns & Advertising -->
		<div class="case-study-block">
			<p class="section-label">Brand Campaigns & Advertising</p>
			<div class="case-study-container">
				{brandingProjects.length > 0 ? brandingProjects.map((project) => (
					<div class="case-study-row" data-case-reveal>
						<div class="case-study-gallery">
							{project.images.map((img) => (
								<div class="case-study-image"><img src={img} alt={project.title} loading="lazy" /></div>
							))}
						</div>
						<div class="case-study-content">
							<h2 class="case-title">{project.title}</h2>
							{project.subtitle && <p class="case-subtitle">{project.subtitle}</p>}
							
							{project.sections.map((section) => (
								<div class="case-detail">
									<h3>{section.heading}</h3>
									<p>{section.text}</p>
