---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Jadd Steinhard">
	<section class="about-section">
		<div class="about-hero">
			<img src="/portrait.jpg" alt="Jadd Steinhard Portrait" class="portrait-placeholder" />
			
			<div class="about-text">
				<h1 class="display-headline">I thrive where creativity collides with chaos, where a killer concept meets a tight deadline and a room full of moving parts. That's my zone.</h1>
				
				<div class="about-copy">
					<p>For twenty+ years, I've lived in the gap between the idea and the execution, the moment a concept has to become something real, on a deadline and in front of people who are watching.</p>
					<p>I design the vision. Then make sure it holds up when everything's live and nothing's forgiving. Resorts, festivals, agencies, international tours, different rooms, same instinct to stay sharp when the pressure hits.</p>
					<p>That tension between idea and execution? I've built a career living in it.</p>
				</div>
			</div>
		</div>

		<div class="stats-block">
			<div class="stat">
				<span class="stat-number">22+</span>
				<span class="stat-label">Years Experience</span>
			</div>
			<div class="stat">
				<span class="stat-number">100s</span>
				<span class="stat-label">Live Events</span>
			</div>
			<div class="stat">
				<span class="stat-number">4</span>
				<span class="stat-label">Continents</span>
			</div>
		</div>

		<div class="tools-block">
			<p class="section-label">Tools & Technical</p>
			<div class="tools-strip">
				<span>Photoshop</span> <span>Illustrator</span> <span>Premiere Pro</span> <span>After Effects</span> <span>Figma</span> <span>Blender</span> <span>Pro Tools</span>
			</div>
		</div>
	</section>
</BaseLayout>